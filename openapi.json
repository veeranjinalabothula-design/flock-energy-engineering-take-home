{
  "openapi": "3.0.3",
  "info": {
    "title": "Urja Meter API",
    "version": "1.0.0",
    "description": "Read-only, normalized API over the Urja Meter Ops portal."
  },
  "servers": [
    { "url": "http://localhost:3000" }
  ],
  "tags": [
    { "name": "Meters" },
    { "name": "Network" },
    { "name": "Health" }
  ],
  "paths": {
    "/api/meters": {
      "get": {
        "tags": ["Meters"],
        "summary": "Search meters",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Search meter ID or serial number."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of matching meters.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeterListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "502": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    },
    "/api/meters/{meterId}": {
      "get": {
        "tags": ["Meters"],
        "summary": "Get a meter, its location and recent consumption",
        "parameters": [
          {
            "name": "meterId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "maximum": 336, "default": 48 },
            "description": "Number of newest readings to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Meter record and latest readings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "$ref": "#/components/schemas/MeterDetail" }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "502": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    },
    "/api/network/transformers": {
      "get": {
        "tags": ["Network"],
        "summary": "List distribution transformers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of transformer records.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TransformerListResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "502": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    },
    "/api/network/transformers/{code}/meters": {
      "get": {
        "tags": ["Network"],
        "summary": "List meters assigned to a transformer",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Meters assigned to the named transformer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Meter" } },
                    "meta": { "type": "object" }
                  },
                  "required": ["data", "meta"]
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "502": { "$ref": "#/components/responses/UpstreamError" }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check API liveness",
        "responses": {
          "200": {
            "description": "API process is responding.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": { "type": "string", "example": "ok" },
                        "timestamp": { "type": "string", "format": "date-time" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Meter": {
        "type": "object",
        "properties": {
          "meterId": { "type": "string" },
          "serialNo": { "type": "string" },
          "make": { "type": "string" },
          "phaseType": { "type": "string" },
          "installStatus": { "type": "string" },
          "dtCode": { "type": "string" }
        },
        "required": ["meterId", "dtCode"]
      },
      "MeterDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Meter" },
          {
            "type": "object",
            "properties": {
              "location": {
                "type": "object",
                "properties": {
                  "latitude": { "type": "number" },
                  "longitude": { "type": "number" }
                },
                "required": ["latitude", "longitude"]
              },
              "network": {
                "type": "object",
                "properties": {
                  "transformer": { "$ref": "#/components/schemas/Transformer" },
                  "feederCode": { "type": "string", "nullable": true }
                }
              },
              "consumption": {
                "type": "object",
                "properties": {
                  "unit": { "type": "string", "example": "kWh" },
                  "sourceReadingCount": { "type": "integer" },
                  "returnedReadingCount": { "type": "integer" },
                  "readings": {
                    "type": "array",
                    "items": { "$ref": "#/components/schemas/Reading" }
                  }
                }
              }
            }
          }
        ]
      },
      "Reading": {
        "type": "object",
        "properties": {
          "timestamp": { "type": "string", "example": "30/06/2026 23:30" },
          "kwh": { "type": "number" },
          "kvah": { "type": "number" },
          "voltageR": { "type": "number" }
        },
        "required": ["timestamp", "kwh", "kvah", "voltageR"]
      },
      "Transformer": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "feederCode": { "type": "string" },
          "capacityKva": { "type": "number" }
        },
        "required": ["code"]
      },
      "MeterListResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Meter" } },
          "meta": { "$ref": "#/components/schemas/Pagination" }
        },
        "required": ["data", "meta"]
      },
      "TransformerListResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Transformer" } },
          "meta": { "$ref": "#/components/schemas/Pagination" }
        },
        "required": ["data", "meta"]
      },
      "Pagination": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "total": { "type": "integer" },
          "totalPages": { "type": "integer" }
        },
        "required": ["page", "pageSize", "total", "totalPages"]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "requestId": { "type": "string" }
            },
            "required": ["code", "message"]
          }
        },
        "required": ["error"]
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "NotFound": {
        "description": "The requested meter, transformer, or route was not found.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "UpstreamError": {
        "description": "The portal returned an error or could not be reached.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    }
  }
}
